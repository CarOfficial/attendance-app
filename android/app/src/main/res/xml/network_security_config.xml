<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The server address is typed by the administrator at login, so any host must be reachable,
      including plain-HTTP LAN addresses (e.g. http://192.168.1.13:8000/api/v1/).
      HTTPS addresses keep their certificate validation either way.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
