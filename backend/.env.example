# Copy to .env and change every value before deploying.
ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://attendance:CHANGE_ME_DB_PASSWORD@db:5432/attendance

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

TIMEZONE=Asia/Tehran
MAX_GPS_ACCURACY_M=100

# Created on first start only if no admin exists. The admin must change this password at first login.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

# Origins allowed to call the API from a browser (the admin panel and PWA). JSON list.
CORS_ORIGINS=["https://admin.example.com","https://app.example.com"]
